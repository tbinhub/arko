{
    "name": "arko",
    "version": "0.1.0",
    "private": true,
    "packageManager": "npm@12.2.2",
    "engines": {
        "node": "26.13.x",
        "npm": "12.2.x"
    },
    "scripts": {
        "predev": "npm run format",
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write . --ignore-unknown",
        "format:check": "prettier --check . --ignore-unknown",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "audit:prod": "npm audit --omit=dev",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@xyflow/react": "^13.0.3",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "elkjs": "^0.12.1",
        "html-to-image": "^1.11.13",
        "lucide-react": "^1.79.0",
        "nanoid": "^6.0.2",
        "next": "16.4.6",
        "next-themes": "^0.4.6",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "sonner": "^2.0.8",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.1",
        "@tailwindcss/turbopack": "4.3.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.13",
        "@types/node": "^26.6.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.1.1",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.4.6",
        "jsdom": "^31.0.1",
        "prettier": "3.10.1",
        "tailwindcss": "4.3.5",
        "typescript": "^5",
        "vitest": "^5.1.1"
    }
}
